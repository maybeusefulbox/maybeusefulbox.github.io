---
import { SITE_NAME, nav } from '../data/site';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <p class="footer-title">{SITE_NAME}</p>
    <nav aria-label="フッターメニュー">
      <ul>
        {nav.map((item) => (
          <li><a href={base + item.path}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="copy">&copy; {year} {SITE_NAME}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
    background: var(--footer-bg);
    color: var(--footer-text);
  }
  .inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 16px 56px;
    text-align: center;
  }
  .footer-title { margin: 0 0 16px; font-size: 1.3rem; font-weight: 700; letter-spacing: 0.06em; }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a { color: inherit; text-decoration: none; font-size: 0.9rem; }
  a:hover { text-decoration: underline; }
  .copy { margin: 32px 0 0; font-size: 0.75rem; opacity: 0.7; }
</style>
