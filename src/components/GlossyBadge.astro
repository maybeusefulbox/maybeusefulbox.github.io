---
// 2000年代前半のホームページ素材風の「グロッシー丸バッジ」。
// 下から順に重ねる4レイヤー構造：
//   1. 縁（リム）     … ベース色を暗くした円。輪郭をくっきりさせる
//   2. 色面           … radialGradient。光が左上から当たっているように見せる
//   3. 内側の影       … 中心は透明・外周だけ暗い radialGradient。縁を締めて立体感を出す
//   (モチーフ)        … 星やハート、文字など。色面の上・ハイライトの下に置く
//   4. ハイライト     … 上部の半透明の楕円。白→透明のグラデーションで「ツヤ」を出す
import { lighten, darken } from '../lib/color';

interface Props {
  /** ベース色（#rrggbb） */
  color?: string;
  /** 中央のモチーフ */
  motif?: 'star' | 'heart' | 'none';
  /** モチーフの代わりに表示する文字（1〜2文字くらいが目安） */
  text?: string;
  /** 表示サイズ（px） */
  size?: number;
  /** 読み上げ用の説明 */
  title?: string;
  /** ハイライト楕円の位置・大きさ・濃さ（後で調整パネルから操作する予定の値） */
  highlight?: { cx?: number; cy?: number; rx?: number; ry?: number; opacity?: number };
}

const {
  color = '#3a8ee6',
  motif = 'star',
  text,
  size = 120,
  title = 'バッジ',
  highlight = {},
} = Astro.props;

const hl = { cx: 50, cy: 30, rx: 32, ry: 19, opacity: 0.9, ...highlight };

// 同じページにバッジを複数置くと、グラデーションの id が重複して
// 全部が最初のバッジの色で塗られてしまう。インスタンスごとに一意な接頭辞を付けて防ぐ。
const uid = 'gb-' + Math.random().toString(36).slice(2, 8);
const ids = {
  base: `${uid}-base`,
  shade: `${uid}-shade`,
  shine: `${uid}-shine`,
};

const rim = darken(color, 0.35);
const light = lighten(color, 0.45);
const deep = darken(color, 0.2);
const motifShadow = darken(color, 0.45);

/** 中心(cx, cy)の5角星のパス。外側半径 r1、内側半径 r2 */
function starPath(cx: number, cy: number, r1: number, r2: number) {
  const pts = Array.from({ length: 10 }, (_, i) => {
    const r = i % 2 === 0 ? r1 : r2;
    const a = -Math.PI / 2 + (i * Math.PI) / 5; // 真上から時計回り
    return `${(cx + r * Math.cos(a)).toFixed(2)},${(cy + r * Math.sin(a)).toFixed(2)}`;
  });
  return `M${pts.join('L')}Z`;
}

const motifPath =
  motif === 'star'
    ? starPath(50, 53, 22, 9.5)
    : motif === 'heart'
      ? 'M50 70 C30 56 28 38 41 37 C46 37 50 41 50 45 C50 41 54 37 59 37 C72 38 70 56 50 70 Z'
      : null;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  role="img"
  aria-label={title}
>
  <defs>
    <!-- 2. 色面：中心を左上寄り(cx=40%, cy=30%)にずらすと、光源が左上にあるように見える -->
    <radialGradient id={ids.base} cx="40%" cy="30%" r="75%">
      <stop offset="0%" stop-color={light} />
      <stop offset="55%" stop-color={color} />
      <stop offset="100%" stop-color={deep} />
    </radialGradient>
    <!-- 3. 内側の影：78%までは透明、外周に向かって暗くなる -->
    <radialGradient id={ids.shade} cx="50%" cy="50%" r="50%">
      <stop offset="78%" stop-color="#000" stop-opacity="0" />
      <stop offset="100%" stop-color="#000" stop-opacity="0.35" />
    </radialGradient>
    <!-- 4. ハイライト：上が白、下に向かって透明に -->
    <linearGradient id={ids.shine} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff" stop-opacity={hl.opacity} />
      <stop offset="100%" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- 1. 縁 -->
  <circle cx="50" cy="50" r="48" fill={rim} />
  <!-- 2. 色面 -->
  <circle cx="50" cy="50" r="44" fill={`url(#${ids.base})`} />
  <!-- 3. 内側の影 -->
  <circle cx="50" cy="50" r="44" fill={`url(#${ids.shade})`} />

  <!-- モチーフ：同じ形を少し下にずらした暗い色で先に描き、刻印のような影にする -->
  {motifPath && !text && (
    <g>
      <path d={motifPath} fill={motifShadow} opacity="0.5" transform="translate(0 1.5)" />
      <path d={motifPath} fill="#fff" />
    </g>
  )}
  {text && (
    <g
      font-family="'Arial Rounded MT Bold', 'Hiragino Maru Gothic ProN', 'M PLUS Rounded 1c', sans-serif"
      font-weight="bold"
      font-size={text.length > 1 ? 30 : 42}
      text-anchor="middle"
      dominant-baseline="central"
    >
      <text x="50" y="55.5" fill={motifShadow} opacity="0.5">{text}</text>
      <text x="50" y="54" fill="#fff">{text}</text>
    </g>
  )}

  <!-- 4. ハイライト -->
  <ellipse cx={hl.cx} cy={hl.cy} rx={hl.rx} ry={hl.ry} fill={`url(#${ids.shine})`} />
</svg>
