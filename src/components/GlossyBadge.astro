---
// グロッシー丸バッジを画面に表示するコンポーネント。
// SVG の組み立て自体は src/lib/badge-svg.ts にあり、配布用ファイルの生成と共通。
import { renderBadgeSvg, type BadgeOptions } from '../lib/badge-svg';

type Props = BadgeOptions;

const { size = 120, ...rest } = Astro.props;

// ページ内でグラデーションの id が重複しないよう、表示1つごとにランダムな接頭辞を付ける
const idPrefix = 'gb-' + Math.random().toString(36).slice(2, 8);
const svg = renderBadgeSvg({ size, idPrefix, ...rest });
---

<Fragment set:html={svg} />
