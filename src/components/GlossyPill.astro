---
// ピル型のグロッシーボタン。バッジと同じ考え方を CSS で再現している。
//   色面       … radial-gradient（上が明るく、下が暗い）
//   内側の影   … inset の box-shadow で下側を暗くし、縁を締める
//   ハイライト … ::before 疑似要素の、白→透明のグラデーション
// href を渡すとリンク（<a>）、渡さないとボタン（<button>）になる。
// id や download など、それ以外の属性はそのまま要素に引き継ぐ。
import type { HTMLAttributes } from 'astro/types';
import { lighten, darken } from '../lib/color';

type Props = (HTMLAttributes<'a'> & HTMLAttributes<'button'>) & {
  color?: string;
  size?: 'sm' | 'md';
  /** 現在のページを表すボタンか（ナビ用） */
  current?: boolean;
};

const { color = '#3a8ee6', size = 'md', current = false, href, class: className, ...rest } = Astro.props;

// 色の計算は JS 側で済ませ、CSS 変数として渡す。CSS は1つのまま、色だけ差し替えられる
const vars = [
  `--c:${color}`,
  `--c-light:${lighten(color, 0.45)}`,
  `--c-dark:${darken(color, 0.22)}`,
  `--c-rim:${darken(color, 0.38)}`,
].join(';');

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['pill', size, { current }, className]}
  href={href}
  type={href ? undefined : 'button'}
  style={vars}
  aria-current={current ? 'page' : undefined}
  {...rest}
>
  <span class="label"><slot /></span>
</Tag>

<style>
  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--c-rim);
    border-radius: 999px;
    /* 色面：楕円の中心を上端に置き、上ほど明るくする */
    background: radial-gradient(ellipse 120% 110% at 50% 0%, var(--c-light), var(--c) 55%, var(--c-dark));
    /* 内側の影（下側を暗く）＋ 縁の内側の細い光 ＋ 落ち影 */
    box-shadow:
      inset 0 -4px 6px rgba(0, 0, 0, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.25),
      0 2px 3px rgba(0, 0, 0, 0.18);
    color: #fff;
    font: inherit;
    font-weight: bold;
    line-height: 1.2;
    text-decoration: none;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.35);
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
  }
  .md { padding: 0.55em 1.3em; font-size: 0.95rem; }
  .sm { padding: 0.3em 0.95em; font-size: 0.8rem; }

  /* ハイライト：上半分にかかる白い膜 */
  .pill::before {
    content: '';
    position: absolute;
    top: 1px;
    left: 6%;
    right: 6%;
    height: 52%;
    border-radius: 999px;
    background: linear-gradient(rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.05));
    pointer-events: none;
  }
  /* 文字はハイライトより手前に出して読みやすくする */
  .label { position: relative; z-index: 1; }

  .pill:hover { filter: brightness(1.08) saturate(1.1); }
  .pill:active { transform: translateY(1px); box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.25); }
  .pill:focus-visible { outline: 3px solid #333a4d; outline-offset: 2px; }
  .pill:disabled { filter: grayscale(1); opacity: 0.5; cursor: not-allowed; }

  /* 現在のページ：白い縁取りで「押されている」状態を表す */
  .current {
    box-shadow:
      0 0 0 2px #fff,
      0 0 0 4px var(--c-rim),
      inset 0 -4px 6px rgba(0, 0, 0, 0.18);
  }
</style>
