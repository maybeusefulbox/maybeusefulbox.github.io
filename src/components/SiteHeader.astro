---
// 全ページ共通のヘッダー。
// スマホ：左にロゴとサイト名、右にハンバーガーメニュー
// PC   ：サイト名を中央に大きく（メニューはフッターにある）
import { SITE_NAME, nav } from '../data/site';
// SVG ファイルを import すると、<Logo /> のようにコンポーネントとして使える（HTML に直接埋め込まれる）
import Logo from '../assets/logo.svg';

const base = import.meta.env.BASE_URL;
// 末尾の / の有無で一致しなくならないよう、そろえてから比べる
const withSlash = (p: string) => (p.endsWith('/') ? p : p + '/');
const here = withSlash(Astro.url.pathname);

// トップページではサイト名がページの見出し（h1）になる。ほかのページでは各ページの h1 を使う
const Title = here === withSlash(base) ? 'h1' : 'p';
---

<header class="site-header">
  <a class="brand" href={base}>
    <!-- 隣にサイト名の文字があるので、ロゴは読み上げ対象から外す -->
    <Logo class="logo" width={52} height={52} aria-hidden="true" />
    <Title class="site-title">{SITE_NAME}</Title>
  </a>

  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="メニューを開く">
    <span></span><span></span><span></span>
  </button>

  <nav id="site-menu" class="menu" aria-label="サイト内メニュー" hidden>
    <ul>
      {nav.map((item) => (
        <li>
          <a href={base + item.path} aria-current={here === withSlash(base + item.path) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1080px;
    margin: 0 auto;
    padding: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }
  .logo { flex-shrink: 0; }
  /*
    ロゴは 400×400 で描かれているので、52px に縮めると線が細くかすれる。
    ヘッダーのロゴだけ線を太くする（SVG 内の style より優先させるため !important）。
    :global() … 線（path）は SVG ファイル由来の要素なので、スコープ付き CSS の対象外になる。そのため global で指定する
  */
  .brand :global(.logo path) { stroke-width: 13px !important; }
  .site-title {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  /* ハンバーガーボタン：3本線 */
  .menu-btn {
    display: grid;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: 10px 8px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .menu-btn span {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.2s, opacity 0.2s;
  }
  /* 開いているときは × に変形する */
  .menu-btn[aria-expanded='true'] span:nth-child(1) { transform: translateY(9px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded='true'] span:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

  /* 開いたメニュー：ヘッダーの下に重ねて表示 */
  .menu {
    position: absolute;
    top: 100%;
    left: 12px;
    right: 12px;
    z-index: 10;
    padding: 8px;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 8px 24px rgba(60, 40, 30, 0.15);
  }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu a {
    display: block;
    padding: 12px 14px;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
  }
  .menu a:hover { background: var(--ph-bg); }
  .menu a[aria-current='page'] { font-weight: 700; color: var(--accent); }

  /* PC：ロゴとハンバーガーを隠し、サイト名を中央に大きく */
  @media (min-width: 768px) {
    .site-header { justify-content: center; padding: 32px 16px 24px; }
    .logo, .menu-btn, .menu { display: none; }
    .site-title { font-size: 2.6rem; }
  }
</style>

<script>
  // ハンバーガーメニューの開け閉め
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = document.getElementById('site-menu')!;

  function setOpen(open: boolean) {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    menu.hidden = !open;
  }

  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  // Esc キーやメニューの外側をクリックしたら閉じる
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  document.addEventListener('click', (e) => {
    if (!btn.contains(e.target as Node) && !menu.contains(e.target as Node)) setOpen(false);
  });
</script>
