---
// 全ページ共通のヘッダー：ロゴ（サイト名）とピル型ボタンのナビ
import GlossyBadge from './GlossyBadge.astro';
import GlossyPill from './GlossyPill.astro';
import { SITE_NAME, SITE_TAGLINE, nav } from '../data/site';

const base = import.meta.env.BASE_URL;
// 末尾の / の有無で一致しなくならないよう、そろえてから比べる
const withSlash = (p: string) => (p.endsWith('/') ? p : p + '/');
const here = withSlash(Astro.url.pathname);
---

<header class="site-header">
  <a class="logo" href={base}>
    <GlossyBadge color="#f06aa8" motif="star" size={44} title="" />
    <span>
      <span class="name">{SITE_NAME}</span>
      <span class="tagline">{SITE_TAGLINE}</span>
    </span>
  </a>
  <nav aria-label="サイト内メニュー">
    {nav.map((item) => (
      <GlossyPill href={base + item.path} color={item.color} size="sm" current={here === withSlash(base + item.path)}>
        {item.label}
      </GlossyPill>
    ))}
  </nav>
</header>

<style>
  .site-header {
    max-width: 960px;
    margin: 0 auto 16px;
    padding: 14px 16px;
    border: 2px solid #fff;
    border-radius: 18px;
    /* 2000年代風：ヘッダー自体もうっすらツヤのある板にする */
    background: linear-gradient(#ffffff, #e6f1ff 55%, #d6e8ff);
    box-shadow: 0 0 0 1px #b9d4f0, 0 3px 8px rgba(58, 110, 170, 0.15);
    display: grid;
    gap: 12px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }
  .name {
    display: block;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #2a5a96;
    text-shadow: 0 1px 0 #fff;
  }
  .tagline { display: block; font-size: 0.75rem; color: #5a7393; }
  nav { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
