---
// 全ページ共通の枠。ヘッダー・本文・フッターを並べ、各ページの中身は <slot /> に入る。
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /**
   * SNS でシェアしたときの画像（public/ogp/ の中のファイル名）。
   * 画像は scripts/build-ogp.mjs で作る。指定しないページはサイト全体の画像になる
   */
  ogImage?: string;
}

const { title, description = SITE_DESCRIPTION, ogImage = 'default.jpg' } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;
// SNS は「https:// から始まる住所（絶対URL）」でないと読めないので、
// astro.config.mjs の site を使って組み立てる
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(`${base}ogp/${ogImage}`, Astro.site).href;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={pageUrl} />
    <!-- OGP：SNS やチャットで URL を貼ったときに出る、タイトル・説明・画像 -->
    <meta property="og:type" content={pageUrl === new URL(base, Astro.site).href ? 'website' : 'article'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <!-- X（旧Twitter）用。summary_large_image で画像を大きく表示する -->
    <meta name="twitter:card" content="summary_large_image" />
    <!-- 丸ゴシックの Web フォント。display=swap で、読み込み前も文字は先に表示される -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* サイト全体の色。ここを変えると全ページの色が変わる */
      :root {
        --bg: #ffffff;
        --surface: #ffffff;
        --text: #3b3330;
        --muted: #7a706b;
        --accent: #a0673f; /* コーヒーっぽい茶色 */
        --line: #e6dfda;
        --ph-bg: #ece7e3; /* 画像の仮置き場の色 */
        --ph-text: #8a7f78;
        --footer-bg: #4a3d37;
        --footer-text: #f4eee9;
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body {
        margin: 0;
        font-family: 'Zen Maru Gothic', 'Hiragino Maru Gothic ProN', sans-serif;
        color: var(--text);
        background: var(--bg);
        line-height: 1.85;
      }
      a { color: var(--accent); }
      h1, h2, h3 { line-height: 1.4; letter-spacing: 0.08em; }
      h1 { font-size: 1.6rem; margin: 0.4em 0 0.5em; }
      h2 { font-size: 1.5rem; margin: 1.6em 0 0.6em; }
      h3 { font-size: 1.05rem; margin: 1.4em 0 0.3em; }
      img { max-width: 100%; height: auto; }

      /* 本文の幅をそろえる入れ物 */
      .site-main {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 16px;
      }
      @media (min-width: 768px) {
        .site-main { padding: 0 32px; }
      }
    </style>
  </head>
  <body>
    <SiteHeader />
    <main class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
