---
// ぷっくりアイコンメーカー
// アップロードした画像を「ボンボンドロップシール」風のぷっくりアイコンに加工する。
// 処理はすべてブラウザ内（下の <script>）で行い、画像はどこにも送信しない。
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import TermsBody from '../components/TermsBody.astro';
import step1 from '../assets/puffy-step1.png';
import step2 from '../assets/puffy-step2.png';
import step3 from '../assets/puffy-step3.png';
import step4 from '../assets/puffy-step4.png';

// 使い方の4ステップ
const steps = [
  { text: '「画像を選ぶ」から\n好きな画像をアップ！', img: step1, alt: '「画像を選ぶ」ボタンを押す画面' },
  { text: 'プロパティでツヤや\nぷっくり度を調整', img: step2, alt: '犬のイラストを読み込み、スライダーで調整している画面' },
  { text: '調整できたら\nPNGで保存', img: step3, alt: '「PNGで保存」ボタンを押す画面' },
  { text: '完成！SNSのアイコン\nなどに使えるよ。', img: step4, alt: 'ぷっくり加工したイラストや写真の完成例' },
];
---

<BaseLayout title="ぷっくりアイコンメーカー" description="画像をボンボンドロップシール風のぷっくりアイコンに加工できる無料ツール。ブラウザ内で完結します。">
  <div class="puffy">
    <h1>ぷっくりアイコンメーカー</h1>
    <p class="lead">
      画像を選ぶと、ボンボンドロップシールのような、ぷっくりツヤツヤのアイコンに加工できます。<br />
      画像はお使いのブラウザの中だけで処理され、どこにも送信されません。
    </p>

    <section class="howto" aria-labelledby="howto-title">
      <h2 id="howto-title" class="mark">使い方</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <Image src={s.img} alt={s.alt} widths={[200, 400]} sizes="(min-width: 768px) 200px, 45vw" class="step-img" />
            <p><span class="num">{'①②③④'[i]}</span>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <div class="layout tool-frame">
      <section class="stage">
        <div class="drop" id="drop">
          <canvas id="sticker" width="560" height="560"></canvas>
          <p id="placeholder">ここに画像をドロップ<br />または「画像を選ぶ」から選択</p>
        </div>
        <p class="hint">プレビューをドラッグすると画像の位置を動かせます</p>
      </section>
  
      <section class="panel">
        <label class="pill">
          画像を選ぶ
          <input type="file" id="file" accept="image/*" hidden />
        </label>
  
        <fieldset>
          <legend>形</legend>
          <div class="inline">
            <label><input type="radio" name="shape" value="circle" checked /> 丸</label>
            <label><input type="radio" name="shape" value="contour" /> 輪郭に沿う</label>
          </div>
          <p class="note">白背景か透明背景のキャラクター画像は、自動で「輪郭に沿う」になります。</p>
          <label class="inline"><input type="checkbox" id="removeBg" checked /> 白背景を消す</label>
          <label class="row" id="toleranceRow">
            <span>消す白の範囲</span>
            <input type="range" id="tolerance" min="4" max="80" step="1" value="20" />
          </label>
        </fieldset>
  
        <label class="row">
          <span>画像の大きさ</span>
          <input type="range" id="scale" min="0.3" max="3" step="0.01" value="1" />
        </label>
  
        <div class="row">
          <span>フチ</span>
          <div class="inline">
            <input type="color" id="borderColor" value="#ffffff" aria-label="フチの色" />
            <input type="range" id="border" min="0" max="24" step="1" value="13" aria-label="フチの太さ" style="flex:1" />
          </div>
        </div>
  
        <label class="row">
          <span>フチの透明感</span>
          <input type="range" id="clarity" min="0" max="100" step="1" value="45" />
        </label>

        <label class="row" id="bgRow">
          <span>背景色（丸のとき、透明部分の色）</span>
          <input type="color" id="bg" value="#ffffff" />
        </label>
  
        <label class="row">
          <span>ぷっくり度</span>
          <input type="range" id="puff" min="0" max="100" step="1" value="24" />
        </label>
  
        <div class="row">
          <span>ツヤ</span>
          <div class="inline" id="presets">
            <button type="button" class="pill small ghost" data-preset="soft">ふんわり</button>
            <button type="button" class="pill small ghost" data-preset="glossy">つやつや</button>
            <button type="button" class="pill small ghost" data-preset="jelly">うるうる</button>
            <button type="button" class="pill small ghost" data-preset="none">なし</button>
          </div>
          <details>
            <summary>詳細設定を開く</summary>
            <label class="row"><span>光の向き（横）</span><input type="range" data-light="x" min="-1" max="1" step="0.01" /></label>
            <label class="row"><span>光の向き（縦）</span><input type="range" data-light="y" min="-1" max="1" step="0.01" /></label>
            <label class="row"><span>大きさ</span><input type="range" data-light="size" min="0" max="1" step="0.01" /></label>
            <label class="row"><span>濃さ</span><input type="range" data-light="strength" min="0" max="1" step="0.01" /></label>
            <label class="row"><span>ぼかし</span><input type="range" data-light="blur" min="0" max="1" step="0.01" /></label>
            <label class="inline"><input type="checkbox" id="sparkle" /> 反対側にも小さな光を足す</label>
          </details>
        </div>
  
        <div class="export">
          <button type="button" class="pill" id="savePng" disabled>PNGで保存（800×800）</button>
          <p class="terms">
            作ったアイコンはSNSのアイコンなどにご自由にお使いください。
            使用する画像は、ご自身で権利を持っているもの、または利用が許可されているものに限ります。
          </p>
        </div>
      </section>
    </div>

    <section class="terms-section" aria-labelledby="terms-title">
      <h2 id="terms-title" class="mark">利用規約</h2>
      <TermsBody level={3} />
    </section>
  </div>

  <script>
    // .astro の <script> は TypeScript として書け、ビルド時にまとめられてページに読み込まれる。
    // 重い計算は src/lib/puffy-render.ts にあり、ここでは画面の操作と計算の呼び出しだけを担当する。
    import {
      buildGeometry,
      looksLikePlainBackground,
      removeWhiteBackground,
      shade,
      type PuffyGeometry,
      type PuffyLight,
    } from '../lib/puffy-render';

    const PREVIEW_SIZE = 560; // プレビューの計算サイズ
    const DRAFT_SIZE = 280; // ドラッグなどの操作中は、軽く動くようにさらに小さく計算する
    const EXPORT_SIZE = 800;
    const CIRCLE_RADIUS = 150; // 400px 基準の丸の半径
    // 「画像の大きさ」の初期値。丸は 1 で隙間なく覆い、輪郭は 2 で絵の長い辺が CONTOUR_SIZE になる
    const DEFAULT_SCALE = { circle: 1, contour: 2 };
    const CONTOUR_SIZE = 160; // 400px 基準

    const PRESETS: Record<string, PuffyLight & { sparkle: boolean }> = {
      soft: { x: -0.45, y: -0.8, size: 0.6, strength: 0.75, blur: 0.5, sparkle: false },
      glossy: { x: -0.45, y: -0.8, size: 0.6, strength: 1, blur: 0.04, sparkle: true },
      jelly: { x: -0.6, y: -0.6, size: 0.85, strength: 0.95, blur: 0.12, sparkle: true },
      none: { x: -0.45, y: -0.8, size: 0.6, strength: 0, blur: 0.04, sparkle: false },
    };

    const state = {
      source: null as HTMLCanvasElement | null, // 読み込んだ元画像
      cutout: null as HTMLCanvasElement | null, // 白背景を消した画像
      cutoutBox: { x: 0, y: 0, w: 1, h: 1 }, // 白背景を消した画像の、絵がある範囲（余白を除く）
      shape: 'circle' as 'circle' | 'contour',
      removeBg: true,
      tolerance: 20,
      scale: 1,
      x: 0, // 画像中心の、キャンバス中心からのずれ（400px 基準）
      y: 0,
      border: 13,
      borderColor: '#ffffff',
      clarity: 45,
      bg: '#ffffff',
      puff: 24,
      light: { x: -0.6, y: -0.6, size: 0.85, strength: 0.95, blur: 0.12 } as PuffyLight,
      sparkle: true,
      preset: 'jelly',
    };

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const canvas = $<HTMLCanvasElement>('sticker');
    const ctx = canvas.getContext('2d')!;
    const drop = $<HTMLDivElement>('drop');
    const placeholder = $<HTMLParagraphElement>('placeholder');

    // ---------- 描画 ----------

    /** 使う画像を、指定サイズの透明な画像の上に配置して返す */
    function composeArt(size: number): ImageData {
      const layer = document.createElement('canvas');
      layer.width = size;
      layer.height = size;
      const c = layer.getContext('2d', { willReadFrequently: true })!;
      const unit = size / 400;
      const center = size / 2;
      const circle = state.shape === 'circle';
      const useCutout = !circle && state.removeBg;
      const image = (useCutout ? state.cutout : state.source)!;
      // 白背景を消すときは余白を除いた範囲を使う。元画像の余白の量で大きさや位置が変わらないようにするため
      const box = useCutout ? state.cutoutBox : { x: 0, y: 0, w: image.width, h: image.height };

      const fit = circle
        ? (CIRCLE_RADIUS * 2) / Math.min(box.w, box.h)
        : CONTOUR_SIZE / DEFAULT_SCALE.contour / Math.max(box.w, box.h);
      const k = fit * state.scale * unit;
      const w = box.w * k;
      const h = box.h * k;

      if (circle) {
        c.beginPath();
        c.arc(center, center, CIRCLE_RADIUS * unit, 0, Math.PI * 2);
        c.clip();
        c.fillStyle = state.bg;
        c.fillRect(0, 0, size, size);
      }
      c.imageSmoothingQuality = 'high';
      c.drawImage(image, box.x, box.y, box.w, box.h, center + state.x * unit - w / 2, center + state.y * unit - h / 2, w, h);
      return c.getImageData(0, 0, size, size);
    }

    function renderAt(size: number, geometry?: PuffyGeometry) {
      const g = geometry ?? buildGeometry(composeArt(size), state.border, state.puff);
      const image = shade(g, {
        puff: state.puff,
        border: state.border,
        borderColor: state.borderColor,
        clarity: state.clarity,
        light: state.light,
        sparkle: state.sparkle,
      });
      return { g, image };
    }

    // 形が変わらない調整（ツヤや色）では形状データを使い回して軽くする
    let cachedGeometry: PuffyGeometry | null = null;
    let frame = 0;
    let settled = true; // false の間は操作中なので、小さいサイズでざっくり描く
    let settleTimer = 0;

    function paint() {
      frame = 0;
      if (!state.source) return;
      if (!settled) {
        const { image } = renderAt(DRAFT_SIZE);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(canvasFromImageData(image), 0, 0, canvas.width, canvas.height);
        return;
      }
      const { g, image } = renderAt(PREVIEW_SIZE, cachedGeometry ?? undefined);
      cachedGeometry = g;
      ctx.putImageData(image, 0, 0);
    }

    function schedulePaint() {
      if (!frame) frame = requestAnimationFrame(paint); // 同じ描画タイミングに何度も計算しない
    }

    function requestRender(shapeChanged = true) {
      if (shapeChanged) {
        cachedGeometry = null;
        settled = false;
        // 操作が止まったら、きれいなサイズで描き直す
        clearTimeout(settleTimer);
        settleTimer = window.setTimeout(() => {
          settled = true;
          schedulePaint();
        }, 180);
      }
      schedulePaint();
    }

    // ---------- 画像の読み込み ----------

    function canvasFromImageData(data: ImageData) {
      const c = document.createElement('canvas');
      c.width = data.width;
      c.height = data.height;
      c.getContext('2d')!.putImageData(data, 0, 0);
      return c;
    }

    /** 透明でない部分を囲む範囲を求める */
    function opaqueBounds(data: ImageData) {
      const { width: w, height: h } = data;
      let minX = w;
      let minY = h;
      let maxX = -1;
      let maxY = -1;
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          if (data.data[(x + y * w) * 4 + 3] > 16) {
            if (x < minX) minX = x;
            if (x > maxX) maxX = x;
            if (y < minY) minY = y;
            if (y > maxY) maxY = y;
          }
        }
      }
      // 全部消えてしまったときは画像全体を使う
      return maxX < 0 ? { x: 0, y: 0, w, h } : { x: minX, y: minY, w: maxX - minX + 1, h: maxY - minY + 1 };
    }

    function updateCutout() {
      if (!state.source) return;
      const c = state.source.getContext('2d', { willReadFrequently: true })!;
      const data = c.getImageData(0, 0, state.source.width, state.source.height);
      const cut = removeWhiteBackground(data, state.tolerance);
      state.cutout = canvasFromImageData(cut);
      state.cutoutBox = opaqueBounds(cut);
    }

    /** 位置と大きさを、今の形の初期値に戻す */
    function resetPlacement() {
      state.x = 0;
      state.y = 0;
      state.scale = DEFAULT_SCALE[state.shape];
      $<HTMLInputElement>('scale').value = String(state.scale);
    }

    function setShape(shape: typeof state.shape) {
      state.shape = shape;
      document.querySelectorAll<HTMLInputElement>('input[name="shape"]').forEach((el) => {
        el.checked = el.value === shape;
      });
      $<HTMLLabelElement>('bgRow').hidden = shape !== 'circle';
    }

    async function loadFile(file: File) {
      if (!file.type.startsWith('image/')) return;
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.src = url;
      await img.decode();
      URL.revokeObjectURL(url);

      // 大きすぎる写真は重いので、長い辺 1200px までに縮めてから使う
      const ratio = Math.min(1, 1200 / Math.max(img.naturalWidth, img.naturalHeight));
      const source = document.createElement('canvas');
      source.width = Math.round(img.naturalWidth * ratio);
      source.height = Math.round(img.naturalHeight * ratio);
      const c = source.getContext('2d', { willReadFrequently: true })!;
      c.imageSmoothingQuality = 'high';
      c.drawImage(img, 0, 0, source.width, source.height);

      state.source = source;
      updateCutout();
      // 白背景・透明背景の画像なら、自動で輪郭に沿わせる
      setShape(looksLikePlainBackground(c.getImageData(0, 0, source.width, source.height)) ? 'contour' : 'circle');
      resetPlacement();

      placeholder.hidden = true;
      $<HTMLButtonElement>('savePng').disabled = false;
      requestRender();
    }

    $<HTMLInputElement>('file').addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) loadFile(file);
    });

    drop.addEventListener('dragover', (e) => {
      e.preventDefault();
      drop.classList.add('dragover');
    });
    drop.addEventListener('dragleave', () => drop.classList.remove('dragover'));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      drop.classList.remove('dragover');
      const file = e.dataTransfer?.files[0];
      if (file) loadFile(file);
    });

    // ---------- ドラッグで位置調整 ----------

    let dragging: { px: number; py: number; x: number; y: number } | null = null;
    canvas.addEventListener('pointerdown', (e) => {
      if (!state.source) return;
      canvas.setPointerCapture(e.pointerId);
      dragging = { px: e.clientX, py: e.clientY, x: state.x, y: state.y };
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      // 画面上の移動量(px)を、400px 基準の座標に換算する
      const unit = 400 / canvas.getBoundingClientRect().width;
      state.x = dragging.x + (e.clientX - dragging.px) * unit;
      state.y = dragging.y + (e.clientY - dragging.py) * unit;
      requestRender();
    });
    const endDrag = () => (dragging = null);
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);

    // ---------- 各コントロール ----------

    document.querySelectorAll<HTMLInputElement>('input[name="shape"]').forEach((el) =>
      el.addEventListener('change', () => {
        setShape(el.value as typeof state.shape);
        resetPlacement();
        requestRender();
      }),
    );

    const bindRange = (id: string, apply: (v: number) => void, shapeChanged = true) =>
      $<HTMLInputElement>(id).addEventListener('input', (e) => {
        apply(Number((e.target as HTMLInputElement).value));
        requestRender(shapeChanged);
      });
    bindRange('scale', (v) => (state.scale = v));
    bindRange('border', (v) => (state.border = v));
    bindRange('puff', (v) => (state.puff = v));
    bindRange('clarity', (v) => (state.clarity = v), false);
    bindRange('tolerance', (v) => {
      state.tolerance = v;
      updateCutout();
    });

    $<HTMLInputElement>('removeBg').addEventListener('change', (e) => {
      state.removeBg = (e.target as HTMLInputElement).checked;
      $<HTMLLabelElement>('toleranceRow').hidden = !state.removeBg;
      requestRender();
    });
    $<HTMLInputElement>('borderColor').addEventListener('input', (e) => {
      state.borderColor = (e.target as HTMLInputElement).value;
      requestRender(false);
    });
    $<HTMLInputElement>('bg').addEventListener('input', (e) => {
      state.bg = (e.target as HTMLInputElement).value;
      requestRender();
    });

    // ツヤ：プリセット（おまかせ）と詳細スライダーの2段階
    const lightInputs = document.querySelectorAll<HTMLInputElement>('input[data-light]');
    const sparkleInput = $<HTMLInputElement>('sparkle');

    function syncLightUI() {
      lightInputs.forEach((el) => (el.value = String(state.light[el.dataset.light as keyof PuffyLight])));
      sparkleInput.checked = state.sparkle;
      document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.preset === state.preset)),
      );
    }

    document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const { sparkle, ...light } = PRESETS[btn.dataset.preset!];
        state.light = light;
        state.sparkle = sparkle;
        state.preset = btn.dataset.preset!;
        syncLightUI();
        requestRender(false);
      }),
    );

    lightInputs.forEach((el) =>
      el.addEventListener('input', () => {
        state.light[el.dataset.light as keyof PuffyLight] = Number(el.value);
        state.preset = ''; // 手で動かしたらプリセットの選択表示を外す
        syncLightUI();
        requestRender(false);
      }),
    );
    sparkleInput.addEventListener('change', () => {
      state.sparkle = sparkleInput.checked;
      requestRender(false);
    });

    // ---------- 書き出し ----------

    $<HTMLButtonElement>('savePng').addEventListener('click', () => {
      if (!state.source) return;
      const { image } = renderAt(EXPORT_SIZE);
      canvasFromImageData(image).toBlob((blob) => {
        if (!blob) return;
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'puffy-icon.png'; // download 属性を付けると、開かずに保存される
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      }, 'image/png');
    });

    syncLightUI();
    setShape('circle');
  </script>
</BaseLayout>

<style>
  .puffy {
    --frame: #d6cfca; /* 使い方とツールを囲む枠の色 */
    --bg: #fdf3f8;
    --panel: #ffffff;
    --text: #333;
    --muted: #777;
    --accent: #f06aa8;
    --accent-dark: #c94785;
    --line: #f1d3e2;
  }
  .lead { font-size: 0.95rem; line-height: 1.8; }

  /* ▼ 付きの見出し */
  .mark { font-size: 1.1rem; margin: 1.6em 0 0.6em; }
  .mark::before { content: '▼'; margin-right: 0.2em; }

  /* 使い方：スマホは2列、PCは横一列で矢印つき */
  .howto .steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 16px;
    margin: 0;
    padding: 20px;
    list-style: none;
    border: 2px solid var(--frame);
    border-radius: 6px;
  }
  .steps li { position: relative; }
  .steps :global(.step-img) { display: block; width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--frame); }
  .steps p { margin: 8px 0 0; font-size: 0.8rem; line-height: 1.6; white-space: pre-line; }
  .num { margin-right: 0.15em; }
  @media (min-width: 768px) {
    .howto .steps { grid-template-columns: repeat(4, 1fr); gap: 56px; padding: 24px 28px; }
    /* ステップの間の ▶ 矢印。画像（正方形）の縦中央に置く */
    .steps li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: calc(50% - 2.4em);
      right: -40px;
      border-style: solid;
      border-width: 16px 0 16px 24px;
      border-color: transparent transparent transparent #bdb4ae;
    }
  }

  /* ツール本体を枠で囲む */
  .layout.tool-frame {
    max-width: none; /* 使い方の枠と幅をそろえる */
    margin-top: 32px;
    padding: 16px;
    border: 2px solid var(--frame);
    border-radius: 6px;
  }

  .terms-section { margin-top: 24px; font-size: 0.9rem; }
  .layout {
    display: grid;
    gap: 24px;
    max-width: 960px;
    margin-top: 16px;
  }
  @media (min-width: 760px) {
    .layout { grid-template-columns: minmax(0, 1fr) 340px; align-items: start; }
    /* 右の設定が長くても、プレビューが画面内に残るようにする */
    .stage { position: sticky; top: 16px; }
  }
  /*
    スマホ：プレビューを画面上部に固定して、設定だけがその下をスクロールするようにする。
