---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { Image } from 'astro:assets';
import Logo from '../assets/logo.svg';
import coffee from '../assets/coffee.webp';
import books from '../assets/books.jpg';
import { SITE_NAME, contents } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={SITE_NAME}>
  <!-- メインイメージ（PCのみ表示）。ロゴと同じ SVG を大きめに表示する -->
  <div class="hero">
    <Logo class="hero-logo" role="img" aria-label={`${SITE_NAME}のロゴ（ふたの開いた箱）`} />
  </div>

  <!-- コンテンツタイル：スマホ2列、PC4列 -->
  <ul class="tiles">
    {contents.map((c) => (
      <li>
        {c.href ? (
          c.icon ? (
            /* 画像ありのタイル：枠の中に画像、枠の下に名前 */
            <a class="tile-link" href={base + c.href}>
              <span class="tile has-icon">
                {/* 下に文字があるので、画像は読み上げ対象から外す（alt を空にする） */}
                {/* 開いてすぐ見える位置にあるので、遅延読み込みにせず最初から読み込む */}
                <Image src={c.icon} alt="" loading="eager" widths={[220, 440]} sizes="(min-width: 768px) 220px, 45vw" class="tile-icon" />
              </span>
              <span class="tile-caption">{c.label}</span>
              {c.desc && <span class="tile-desc">{c.desc}</span>}
            </a>
          ) : (
            <a class="tile" href={base + c.href}>
              <span class="tile-label">{c.label}</span>
            </a>
          )
        ) : (
          <div class="tile soon">
            <span class="tile-label">{c.label}</span>
            <span class="soon-tag">準備中</span>
          </div>
        )}
      </li>
    ))}
  </ul>

  <section class="row">
    <div class="text">
      <h2>本サイトについて</h2>
      <p>
        誰かの役に立つような立たないような気がするツールや素材を配布するサイトです。<br />
        コーヒーでも飲みながらゆるく楽しんでください。
      </p>
    </div>
    <!-- <Image> はビルド時に表示サイズへ縮小し、軽い WebP に変換してくれる。widths は用意するサイズの候補 -->
    <Image src={coffee} alt="コーヒーサーバーとマグカップのイラスト" widths={[400, 800]} sizes="(min-width: 768px) 400px, 80vw" class="row-img coffee" />
  </section>

  <!-- PCでは画像が左・文章が右（上のセクションと左右を入れ替える） -->
  <section class="row reverse">
    <div class="text">
      <h2>利用規約</h2>
      <p>
        配布している素材やツールは、個人・商用を問わず無料でお使いいただけます。<br />
        ご利用前に一度下記のページもご確認ください。
      </p>
      <p><a href={`${base}terms/`}>利用規約を読む →</a></p>
    </div>
    <Image src={books} alt="積み重なった本のイラスト" widths={[260, 520]} sizes="260px" class="row-img books" />
  </section>

  <!-- 広告（src/data/ads.ts で place: 'top' にしたものだけ表示） -->
  <AdSlot place="top" />
</BaseLayout>

<style>
  .hero { display: none; }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  .tile {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 8px;
    border-radius: 16px;
    background: var(--ph-bg);
    color: var(--text);
    text-align: center;
    text-decoration: none;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .tile-label { white-space: pre-line; } /* \n を改行として表示 */
  /* 画像ありのタイル：枠いっぱいに画像を表示し、角の丸みに合わせて切り抜く（overflow: hidden） */
  .tile-link { display: block; color: var(--text); text-decoration: none; }
  .tile.has-icon {
    padding: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--line);
  }
  .tile :global(.tile-icon) { display: block; width: 100%; height: 100%; min-height: 0; object-fit: cover; }
  /* 名前の下の短い説明 */
  .tile-desc {
    display: block;
    margin-top: 4px;
    color: var(--muted, #777);
    font-size: 0.78rem;
    line-height: 1.6;
    text-align: center;
  }
  /* 枠の下に出す名前。文字の大きさは font-size で変えられる */
  .tile-caption {
    display: block;
    margin-top: 8px;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0;
    /* 言葉の途中では折り返さず、label の「\u200B」の位置でだけ折り返す */
    word-break: keep-all;
  }
  a.tile:hover, .tile-link:hover .tile { transform: translateY(-3px); box-shadow: 0 6px 16px rgba(60, 40, 30, 0.15); }
  .tile.soon { color: var(--ph-text); }
  .soon-tag {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 0 8px;
    border-radius: 999px;
    background: #fff;
    font-size: 0.7rem;
    font-weight: 500;
  }

  .row { margin-top: 48px; }
  .row .text p { margin: 0 0 0.6em; }
  .row :global(.row-img) { display: block; margin: 16px auto 0; height: auto; }
  /* 画像の表示サイズ。数値を変えると大きさが変わる */
  .row :global(.coffee) { width: min(80%, 360px); }
  .row :global(.books) { width: 180px; }

  @media (min-width: 768px) {
    /* メインイメージは控えめな大きさにする。数値を変えると大きさが変わる */
    .hero {
      display: block;
      width: 240px;
      margin: -8px auto 40px;
    }
    .hero :global(.hero-logo) { display: block; width: 100%; height: auto; }
    .tiles { grid-template-columns: repeat(4, 1fr); gap: 48px; padding: 0 3%; }
    .tile { font-size: 1.2rem; }

    /* 文章と画像を横に並べる */
    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
      margin-top: 88px;
      padding: 0 3%;
    }
    .row h2 { margin-top: 0; }
    .row :global(.row-img) { margin-top: 0; }
    .row :global(.coffee) { width: 400px; }
    .row :global(.books) { width: 240px; }
    /* 2つ目のセクションは画像を左に */
    .row.reverse :global(.row-img) { order: -1; }
  }
</style>
