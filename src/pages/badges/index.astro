---
// グロッシーバッジ素材の配布ページ。
// 素材の一覧は src/data/badges.ts にあり、ファイル本体は [id].svg.ts / [id].png.ts がビルド時に生成する。
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlossyBadge from '../../components/GlossyBadge.astro';
import GlossyPill from '../../components/GlossyPill.astro';
import { badges, motifs, PNG_SIZE } from '../../data/badges';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="グロッシーバッジ素材" description="2000年代風のツヤツヤ丸バッジ素材。SVG・PNGで無料配布しています。">
  <h1>グロッシーバッジ素材</h1>
  <p>
    ツヤツヤの丸いバッジ素材です。SVG（拡大しても劣化しない形式）と PNG（{PNG_SIZE}×{PNG_SIZE}px・背景透明）を用意しています。
  </p>
  <p>
    <GlossyPill href={`${base}badges/maker/`} color="#2fbf9b" size="sm">好きな色で作る → 色変更ツール</GlossyPill>
  </p>

  <!-- 利用規約の要点はダウンロードボタンの近くに常に見せる -->
  <aside class="terms">
    <strong>ご利用について</strong>
    <ul>
      <li>個人・商用を問わず無料でお使いいただけます（小説の表紙、サイト、同人誌など）</li>
      <li>色や大きさの変更などの加工OK・クレジット表記は不要です</li>
      <li>素材そのものの再配布・販売、自作発言はご遠慮ください</li>
    </ul>
    <a href={`${base}terms/`}>利用規約の全文を読む</a>
  </aside>

  {motifs.map((m) => (
    <section>
      <h2>{m.name}</h2>
      <div class="grid">
        {badges
          .filter((b) => b.motif === m.key)
          .map((b) => (
            <figure class="card">
              <GlossyBadge color={b.color} motif={b.motif} title={b.name} size={96} />
              <figcaption>{b.name}</figcaption>
              <div class="dl">
                {/* download 属性：リンク先を開かずに、指定したファイル名で保存させる */}
                <GlossyPill size="sm" color={b.color} href={`${base}badges/${b.id}.svg`} download={`glossy-badge-${b.id}.svg`}>SVG</GlossyPill>
                <GlossyPill size="sm" color={b.color} href={`${base}badges/${b.id}.png`} download={`glossy-badge-${b.id}.png`}>PNG</GlossyPill>
              </div>
            </figure>
          ))}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .terms {
    background: #f6faff;
    border: 1px solid #cfe1f5;
    border-left: 4px solid #3a8ee6;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 0.85rem;
  }
  .terms ul { margin: 6px 0; padding-left: 1.2em; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
  }
  .card {
    margin: 0;
    padding: 12px 8px;
    background: linear-gradient(#fff, #f3f8ff);
    border: 1px solid #cfe1f5;
    border-radius: 12px;
    text-align: center;
  }
  figcaption { font-size: 0.8rem; color: #555; }
  .dl { display: flex; justify-content: center; gap: 6px; margin-top: 6px; }
</style>
