---
// メダル風アイコンメーカー。好きな色・ツヤでバッジを作って保存できる。
// 種類は2つ：
//   シンプル … 星・ハートのバッジ。配布素材と同じ renderBadgeSvg() で描くので、見た目は素材と一致する
//   文字入り … 円に沿った文字と中央の文字が入るバッジ。renderTextBadgeSvg() で描く
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlossyPill from '../../components/GlossyPill.astro';
import type { Motif } from '../../lib/badge-svg';
import { FONTS } from '../../lib/fonts';
import { TEXT_BADGE_PRESETS } from '../../data/text-badge-presets';
import { NEON_COLORS } from '../../lib/text-badge-svg';

const base = import.meta.env.BASE_URL;

// おすすめの色見本（最後の3つは金・銀・銅）
const swatches = [
  '#3a8ee6', '#5bc0f8', '#2fbf9b', '#8ccf3f', '#f5c623',
  '#f59a23', '#e64545', '#f06aa8', '#ff9ec7', '#9b6ae6',
  '#6b7a99', '#333a4d', '#e6b422', '#aeb6c2', '#c8814a',
];
const first = TEXT_BADGE_PRESETS[0];

// シンプルのときに選べるモチーフ（「なし」は下の HTML に直接書いている）
const motifs: { key: Motif; name: string }[] = [
  { key: 'star', name: '星' },
  { key: 'heart', name: 'ハート' },
];
---

<BaseLayout title="メダル風アイコンメーカー" description="円に沿った文字入りの缶バッジ・メダル風バッジを作って、SVG・PNGで保存できる無料ツールです。">
  <h1>メダル風アイコンメーカー</h1>
  <p class="lead">
    缶バッジのような、ツヤツヤのバッジ風アイコンを作れます。<br />
    文字や画像はお使いのブラウザの中で処理され、どこにも送信されません。
  </p>

  <div class="layout">
    <!-- スマホでは、設定を操作している間もバッジが見えるよう、画面の上に貼り付ける（sticky） -->
    <section class="preview">
      <div class="stage-wrap">
        <div id="preview" class="stage"></div>
        <p class="loading" id="loading" hidden>フォントを読み込み中…</p>
      </div>
      <p class="hex" id="hexLabel"></p>
    </section>

    <section class="panel">
      <div class="row">
        <span class="label">種類</span>
        <div class="inline">
          <button type="button" class="chip" data-mode="text">文字入り</button>
          <button type="button" class="chip" data-mode="simple">シンプル</button>
        </div>
      </div>

      <!-- 文字入りのときだけ表示する設定 -->
      <div class="text-settings" id="textSettings">
        <div class="row">
          <span class="label">見本から選ぶ</span>
          <div class="inline">
            {TEXT_BADGE_PRESETS.map((p) => (
              <button type="button" class="chip" data-tpreset={p.key}>{p.name}</button>
            ))}
          </div>
        </div>

        <!-- maxlength：入力できる文字数の上限。これを超える長さだと、文字が小さくなりすぎて読めないため -->
        <label class="row">
          <span class="label">上の文字 <span class="note">（円の上側に沿って入ります）</span></span>
          <input type="text" id="topText" maxlength="30" value={first.top} autocomplete="off" />
        </label>
        <label class="row">
          <span class="label">下の文字 <span class="note">（空欄でもOK）</span></span>
          <input type="text" id="bottomText" maxlength="20" value={first.bottom} autocomplete="off" />
        </label>
        <div class="row">
          <span class="label">中央</span>
          <div class="inline">
            <button type="button" class="chip" data-center="text">文字</button>
            <button type="button" class="chip" data-center="image">画像</button>
          </div>
        </div>

        <!-- 中央を「画像」にしたときだけ表示する設定 -->
        <div class="image-settings" id="imageSettings" hidden>
          <!-- accept：選べるファイルの種類を画像に絞る -->
          <label class="file-button">
            <input type="file" id="imageFile" accept="image/*" />
            <span>画像を選ぶ</span>
          </label>
          <p class="note">写真などが丸い形に切り抜かれて入ります。画像はお使いのブラウザの中だけで処理されます。</p>
          <label class="row"><span>大きさ</span><input type="range" id="imgZoom" min="1" max="3" step="0.01" value="1" /></label>
          <label class="row"><span>横位置</span><input type="range" id="imgX" min="-1" max="1" step="0.01" value="0" /></label>
          <label class="row"><span>縦位置</span><input type="range" id="imgY" min="-1" max="1" step="0.01" value="0" /></label>
          <label class="inline"><input type="checkbox" id="overlayText" /> 画像の上に中央の文字も重ねる</label>
        </div>

        <label class="row" id="centerTextRow">
          <span class="label">中央の文字 <span class="note">（2〜3文字がおすすめ）</span></span>
          <input type="text" id="centerText" maxlength="8" value={first.center} autocomplete="off" />
        </label>
        <p class="notice" id="notice" hidden></p>

        <div class="row">
          <span class="label">文字の色</span>
          <div class="inline">
            <button type="button" class="chip" data-textcolor="auto">自動</button>
            <button type="button" class="chip" data-textcolor="white">白</button>
            <button type="button" class="chip" data-textcolor="dark">濃い色</button>
          </div>
          <!-- 蛍光色：コンサートのうちわのような、縁取り付きの文字になる -->
          <div class="inline">
            {Object.entries(NEON_COLORS).map(([key, n]) => (
              <button type="button" class="chip neon" data-textcolor={key}>
                <span class="dot" style={`background:${n.hex}`}></span>{n.name}
              </button>
            ))}
          </div>
        </div>

        <label class="row">
          <span class="label">フォント</span>
          <select id="font">
            <optgroup label="日本語も使えるフォント">
              {FONTS.filter((f) => f.lang === 'ja').map((f) => (
                <option value={f.key} selected={f.key === first.font}>{f.name}</option>
              ))}
            </optgroup>
            <optgroup label="英字フォント（日本語は丸ゴシックで表示）">
              {FONTS.filter((f) => f.lang === 'en').map((f) => (
                <option value={f.key} selected={f.key === first.font}>{f.name}</option>
              ))}
            </optgroup>
          </select>
        </label>
      </div>

      <div class="row">
        <span class="label">色</span>
        <div class="swatches">
          {swatches.map((c) => (
            <button type="button" class="swatch" data-color={c} style={`background:${c}`} aria-label={c} />
          ))}
        </div>
        <label class="inline">
          <input type="color" id="color" value={first.color} />
          <span class="note">自由に選ぶ</span>
        </label>
      </div>

      <!-- シンプルのときだけ表示する設定 -->
      <fieldset class="row" id="motifRow" hidden>
        <legend class="label">モチーフ</legend>
        <div class="inline">
          {motifs.map((m, i) => (
            <label><input type="radio" name="motif" value={m.key} checked={i === 0} /> {m.name}</label>
          ))}
          <label><input type="radio" name="motif" value="none" /> なし</label>
        </div>
      </fieldset>

      <div class="row">
        <span class="label">ツヤ</span>
        <div class="inline" id="presets">
          <button type="button" class="chip" data-preset="normal">ふつう</button>
          <button type="button" class="chip" data-preset="soft">ひかえめ</button>
          <button type="button" class="chip" data-preset="strong">つよめ</button>
          <button type="button" class="chip" data-preset="none">なし</button>
        </div>
        <!-- 上級者向け：普段は閉じておき、開いた人だけスライダーを触れるようにする -->
        <details>
          <summary>詳細設定を開く</summary>
          <label class="row"><span>横位置</span><input type="range" data-hl="cx" min="20" max="80" step="0.5" /></label>
          <label class="row"><span>縦位置</span><input type="range" data-hl="cy" min="10" max="60" step="0.5" /></label>
          <label class="row"><span>横幅</span><input type="range" data-hl="rx" min="8" max="44" step="0.5" /></label>
          <label class="row"><span>高さ</span><input type="range" data-hl="ry" min="5" max="40" step="0.5" /></label>
          <label class="row"><span>濃さ</span><input type="range" data-hl="opacity" min="0" max="1" step="0.01" /></label>
        </details>
      </div>

      <div class="row">
        <span class="label">保存</span>
        <label class="inline">
          PNGのサイズ
          <select id="pngSize">
            <option value="128">128×128</option>
            <option value="256">256×256</option>
            <option value="512" selected>512×512</option>
          </select>
        </label>
        <div class="inline">
          <GlossyPill id="savePng" color="#3a8ee6">PNGで保存</GlossyPill>
          <GlossyPill id="saveSvg" color="#6b7a99">SVGで保存</GlossyPill>
        </div>
        <p class="note">
          SVGの文字は図形に変換して保存するので、フォントが入っていないパソコンでも同じ見た目で開けます。<br />
          作ったバッジは、<a href={`${base}terms/`}>利用規約</a>の範囲で個人・商用を問わず無料でお使いいただけます。
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .lead { color: #666; font-size: 0.9rem; }
  .layout { display: grid; gap: 24px; }
  @media (min-width: 760px) {
    .layout { grid-template-columns: minmax(0, 1fr) 340px; align-items: start; }
    /* PCでも、長い設定欄をスクロールしている間バッジが見えるようにする */
    .preview { position: sticky; top: 16px; }
  }
  /* スマホ：プレビューを画面の上に貼り付け、画面の高さの3分の1ほどの大きさにする */
  @media (max-width: 759px) {
    .preview {
      position: sticky;
      top: 0;
      z-index: 5;
      margin: 0 -16px;
      padding: 8px 16px 4px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
  }
  .stage-wrap { position: relative; }
  .stage {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1;
    margin: 0 auto;
    padding: 24px;
    border-radius: 16px;
    border: 1px solid #dfe5f0;
    background: repeating-conic-gradient(#eef1f6 0 25%, #fff 0 50%) 0 0 / 24px 24px;
  }
  .stage :global(svg) { display: block; width: 100%; height: 100%; }
  .loading {
    position: absolute;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%);
    margin: 0;
    padding: 2px 10px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .hex { text-align: center; font-family: monospace; color: #666; }
  /* スマホ用の大きさ。上の .stage / .hex の指定を上書きするため、それより後ろに書く */
  @media (max-width: 759px) {
    .stage { max-width: min(100%, 34vh); padding: 12px; }
    .hex { margin: 2px 0 0; font-size: 0.75rem; }
  }

  .panel {
    background: #fff;
    border: 1px solid #dfe5f0;
    border-radius: 16px;
    padding: 16px;
    display: grid;
    gap: 18px;
  }
  .text-settings { display: grid; gap: 14px; }
  .image-settings {
    display: grid;
    gap: 8px;
    padding: 10px 12px;
    border-radius: 10px;
    background: #f6f8fc;
  }
  .image-settings .row span { font-size: 0.8rem; }
  /* ファイル選択の標準の見た目は環境ごとに違うので、input を隠してボタン風の見た目を付ける */
  .file-button input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .file-button span {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: #333a4d;
    color: #fff;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .file-button input:focus-visible + span { outline: 2px solid #3a8ee6; outline-offset: 2px; }
  /* [hidden] は display の指定で上書きされてしまうので、ここでも隠す */
  [hidden] { display: none !important; }
  .row { display: grid; gap: 6px; }
  .label, legend { font-size: 0.85rem; font-weight: bold; }
  .label .note { font-weight: normal; }
  fieldset { border: 0; margin: 0; padding: 0; }
  .inline { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 0.9rem; }
  .note { font-size: 0.75rem; color: #777; margin: 0; }
  .notice { white-space: pre-line; margin: 0; padding: 6px 10px; border-radius: 8px; background: #fff4e5; color: #8a4b00; font-size: 0.8rem; }
  input[type='text'], select {
    width: 100%;
    padding: 6px 8px;
    border: 1px solid #ccd3e0;
    border-radius: 8px;
    font: inherit;
    font-size: 1rem; /* 16px 未満だと、iPhone で入力時に画面が勝手に拡大されるため */
  }
  #pngSize { width: auto; }
  input[type='range'] { width: 100%; }
  input[type='color'] { width: 40px; height: 32px; padding: 0; border: 1px solid #dfe5f0; border-radius: 6px; }

  .swatches { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; max-width: 260px; }
  .swatch {
    aspect-ratio: 1;
    border: 2px solid #fff;
    border-radius: 50%;
    box-shadow: 0 0 0 1px #ccd3e0, inset 0 -3px 4px rgba(0, 0, 0, 0.2), inset 0 3px 3px rgba(255, 255, 255, 0.5);
    cursor: pointer;
  }
  .swatch[aria-pressed='true'] { box-shadow: 0 0 0 3px #333a4d; }

  .chip {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid #ccd3e0;
    background: #fff;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .chip[aria-pressed='true'] { background: #333a4d; border-color: #333a4d; color: #fff; }
  .chip.neon { display: inline-flex; align-items: center; gap: 5px; }
  .chip .dot { width: 12px; height: 12px; border-radius: 50%; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25); }

  details summary { cursor: pointer; font-size: 0.85rem; color: #2a6fc0; }
  details[open] { display: grid; gap: 8px; }
  details .row span { font-size: 0.8rem; }
</style>

<script>
  // ブラウザ側でも、配布素材と同じ関数で SVG を組み立てる
  import { renderBadgeSvg, type Motif, type Highlight } from '../../lib/badge-svg';
  import { renderTextBadgeSvg, needsFallback, type TextColorMode } from '../../lib/text-badge-svg';
  import { loadFont, FALLBACK_FONT_KEY } from '../../lib/fonts';
  import { TEXT_BADGE_PRESETS } from '../../data/text-badge-presets';
  import type { Font } from 'opentype.js';

  // ツヤのおまかせ設定。数値は viewBox（0〜100）上の位置・大きさ
  const PRESETS: Record<string, Highlight> = {
    normal: { cx: 50, cy: 30, rx: 32, ry: 19, opacity: 0.9 },
    soft: { cx: 50, cy: 28, rx: 26, ry: 14, opacity: 0.55 },
    strong: { cx: 50, cy: 32, rx: 36, ry: 23, opacity: 1 },
    none: { cx: 50, cy: 30, rx: 32, ry: 19, opacity: 0 },
  };

  const first = TEXT_BADGE_PRESETS[0];
  const state = {
    mode: 'text' as 'text' | 'simple',
    color: first.color,
    motif: 'star' as Motif,
    hl: { ...PRESETS.normal },
    preset: 'normal',
    // 文字入り
    tpreset: first.key,
    top: first.top,
    bottom: first.bottom,
    center: first.center,
    textColor: first.textColor as TextColorMode,
    font: first.font,
    // 中央：文字か画像か
    centerMode: 'text' as 'text' | 'image',
    overlay: false, // 画像の上に中央の文字も重ねるか
    image: null as { href: string; width: number; height: number } | null,
    zoom: 1,
    imgX: 0,
    imgY: 0,
  };

  /** 中央に描く文字。画像を使っていて、文字を重ねない設定なら空にする */
  function centerTextNow() {
    return state.centerMode === 'text' || state.overlay ? state.center : '';
  }
  function allTextNow() {
    return state.top + state.bottom + centerTextNow();
  }

  // 読み込み済みのフォント（保存のときにもこれを使う）
  let font: Font | undefined;
  let fallback: Font | undefined;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const preview = $('preview');
  const hexLabel = $('hexLabel');
  const loading = $('loading');
  const notice = $('notice');
  const colorInput = $<HTMLInputElement>('color');
  const topInput = $<HTMLInputElement>('topText');
  const bottomInput = $<HTMLInputElement>('bottomText');
  const centerInput = $<HTMLInputElement>('centerText');
  const fontSelect = $<HTMLSelectElement>('font');
  const hlInputs = document.querySelectorAll<HTMLInputElement>('input[data-hl]');

  /** 今の設定で SVG の文字列を作る。文字入りでフォントがまだ読み込めていないときは null */
  function svgString(size?: number): string | null {
    if (state.mode === 'simple') {
      return renderBadgeSvg({
        color: state.color,
        motif: state.motif,
        highlight: state.hl,
        size,
        title: 'グロッシーバッジ',
        idPrefix: 'maker',
      });
    }
    if (!font) return null;
    const result = renderTextBadgeSvg({
      color: state.color,
      top: state.top,
      bottom: state.bottom,
      center: centerTextNow(),
      textColor: state.textColor,
      font,
      fallback,
      highlight: state.hl,
      image:
        state.centerMode === 'image' && state.image
          ? { ...state.image, zoom: state.zoom, x: state.imgX, y: state.imgY }
          : undefined,
      size,
      idPrefix: 'maker',
    });
    showNotice(result.missing, result.tooLong);
    return result.svg;
  }

  /** 使えない文字や、長すぎる文字があるときに知らせる */
  function showNotice(missing: string[], tooLong: { top: boolean; bottom: boolean; center: boolean }) {
    const msgs: string[] = [];
    if (state.centerMode === 'image' && !state.image) msgs.push('「画像を選ぶ」から、中央に入れる画像を選んでください。');
    if (missing.length) msgs.push(`使えない文字があります：${missing.join(' ')}（フォントに入っていないため表示されません）`);
    const long = [tooLong.top && '上', tooLong.bottom && '下', tooLong.center && '中央'].filter(Boolean);
    if (long.length) msgs.push(`${long.join('・')}の文字が長いため、小さく表示されています。`);
    notice.textContent = msgs.join('\n');
    notice.hidden = msgs.length === 0;
  }

  // フォントの読み込みは時間がかかるので、読み込み中に別のフォントを選び直されたときは古い結果を捨てる
  let loadSeq = 0;
  async function ensureFonts() {
    const seq = ++loadSeq;
    const allText = allTextNow();
    loading.hidden = false;
    try {
      const main = await loadFont(state.font);
      // 選んだフォントにない文字（英字フォントでの日本語など）があるときだけ、代わりのフォントも読み込む
      const fb = needsFallback(main, allText) ? await loadFont(FALLBACK_FONT_KEY) : fallback;
      if (seq !== loadSeq) return;
      font = main;
      fallback = fb;
    } catch {
      if (seq !== loadSeq) return;
      notice.textContent = 'フォントを読み込めませんでした。通信状況を確認して、ページを再読み込みしてください。';
      notice.hidden = false;
    } finally {
      if (seq === loadSeq) loading.hidden = true;
    }
    render();
  }

  function render() {
    // 文字入りで、まだフォントがないとき・必要な代わりのフォントがないときは、読み込んでから描き直す
    if (state.mode === 'text') {
      const allText = allTextNow();
      if (!font || (needsFallback(font, allText) && !fallback)) {
        if (loading.hidden) ensureFonts();
        if (!font) return;
      }
    }
    const svg = svgString();
    if (svg) preview.innerHTML = svg;

    hexLabel.textContent = state.color;
    colorInput.value = state.color;
    $('textSettings').hidden = state.mode !== 'text';
    $('motifRow').hidden = state.mode !== 'simple';
    if (state.mode === 'simple') notice.hidden = true;
    const pressed = (sel: string, key: string, value: string) =>
      document.querySelectorAll<HTMLButtonElement>(sel).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset[key] === value)));
    pressed('.swatch', 'color', state.color);
    pressed('[data-preset]', 'preset', state.preset);
    pressed('[data-mode]', 'mode', state.mode);
    pressed('[data-tpreset]', 'tpreset', state.tpreset);
    pressed('[data-textcolor]', 'textcolor', state.textColor);
    pressed('[data-center]', 'center', state.centerMode);
    $('imageSettings').hidden = state.centerMode !== 'image';
    $('centerTextRow').hidden = state.centerMode === 'image' && !state.overlay;
    hlInputs.forEach((el) => (el.value = String(state.hl[el.dataset.hl as keyof Highlight])));
  }

  // ---------- 操作 ----------

  document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
    b.addEventListener('click', () => {
      state.mode = b.dataset.mode as 'text' | 'simple';
      render();
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('.swatch').forEach((b) =>
    b.addEventListener('click', () => {
      state.color = b.dataset.color!;
      state.tpreset = '';
      render();
    }),
  );
  // input イベント：カラーピッカーを動かしている最中も、リアルタイムに反映される
  colorInput.addEventListener('input', () => {
    state.color = colorInput.value;
    state.tpreset = '';
    render();
  });

  document.querySelectorAll<HTMLInputElement>('input[name="motif"]').forEach((el) =>
    el.addEventListener('change', () => {
      state.motif = el.value as Motif;
      render();
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
    b.addEventListener('click', () => {
      state.preset = b.dataset.preset!;
      state.hl = { ...PRESETS[state.preset] };
      render();
    }),
  );
  hlInputs.forEach((el) =>
    el.addEventListener('input', () => {
      state.hl[el.dataset.hl as keyof Highlight] = Number(el.value);
      state.preset = ''; // 手で動かしたら、プリセットの選択表示を外す
      render();
    }),
  );

  // ---------- 中央の画像 ----------

  document.querySelectorAll<HTMLButtonElement>('[data-center]').forEach((b) =>
    b.addEventListener('click', () => {
      state.centerMode = b.dataset.center as 'text' | 'image';
      state.tpreset = '';
      render();
    }),
  );

  // SVG の中に画像をそのまま埋め込むので、大きな写真はこの大きさ（px）まで縮めてから使う。
  // 縮めないと、スマホの写真では SVG が数MBになってしまうため
  const IMAGE_MAX = 600;

  $<HTMLInputElement>('imageFile').addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    try {
      // createImageBitmap：画像ファイルを、canvas に描ける形に読み込む（スマホ写真の向きも直してくれる）
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, IMAGE_MAX / Math.max(bmp.width, bmp.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bmp.width * scale);
      canvas.height = Math.round(bmp.height * scale);
      const ctx = canvas.getContext('2d')!;
      ctx.drawImage(bmp, 0, 0, canvas.width, canvas.height);
      bmp.close();
      // 透明な部分がある画像だけ PNG（透明を保てるが重い）、それ以外は JPEG（軽い）で埋め込む。
      // getImageData で全ピクセルを調べ、4つ目の値（不透明度）が 255 未満のものがあれば透明部分あり
      const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
      let hasAlpha = false;
      for (let i = 3; i < data.length; i += 4) {
        if (data[i] < 255) {
          hasAlpha = true;
          break;
        }
      }
      const href = hasAlpha ? canvas.toDataURL('image/png') : canvas.toDataURL('image/jpeg', 0.9);
      state.image = { href, width: canvas.width, height: canvas.height };
      state.zoom = 1;
      state.imgX = 0;
      state.imgY = 0;
      for (const [id, v] of [['imgZoom', 1], ['imgX', 0], ['imgY', 0]] as const) $<HTMLInputElement>(id).value = String(v);
      render();
    } catch {
      notice.textContent = 'この画像は読み込めませんでした。JPEG や PNG の画像でお試しください。';
      notice.hidden = false;
    }
  });

  for (const [id, key] of [['imgZoom', 'zoom'], ['imgX', 'imgX'], ['imgY', 'imgY']] as const) {
    const el = $<HTMLInputElement>(id);
    el.addEventListener('input', () => {
      state[key] = Number(el.value);
      render();
    });
  }

  $<HTMLInputElement>('overlayText').addEventListener('change', (e) => {
    state.overlay = (e.target as HTMLInputElement).checked;
    render();
  });

  // 文字入りの見本：色・文字・フォントをまとめて切り替える
  document.querySelectorAll<HTMLButtonElement>('[data-tpreset]').forEach((b) =>
    b.addEventListener('click', () => {
      const p = TEXT_BADGE_PRESETS.find((x) => x.key === b.dataset.tpreset)!;
      Object.assign(state, {
        tpreset: p.key,
        color: p.color,
        top: p.top,
        bottom: p.bottom,
        center: p.center,
        textColor: p.textColor,
        font: p.font,
        centerMode: 'text', // 見本は中央が文字なので、文字に戻す
      });
      topInput.value = p.top;
      bottomInput.value = p.bottom;
      centerInput.value = p.center;
      fontSelect.value = p.font;
      ensureFonts();
    }),
  );

  for (const [input, key] of [
    [topInput, 'top'],
    [bottomInput, 'bottom'],
    [centerInput, 'center'],
  ] as const) {
    input.addEventListener('input', () => {
      state[key] = input.value;
      state.tpreset = '';
      render();
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-textcolor]').forEach((b) =>
    b.addEventListener('click', () => {
      state.textColor = b.dataset.textcolor as TextColorMode;
      state.tpreset = '';
      render();
    }),
  );

  fontSelect.addEventListener('change', () => {
    state.font = fontSelect.value;
    state.tpreset = '';
    ensureFonts();
  });

  // ---------- 保存 ----------

  function fileBase() {
    return state.mode === 'simple'
      ? `glossy-badge-${state.motif}-${state.color.slice(1)}`
      : `glossy-badge-text-${state.color.slice(1)}`;
  }

  function download(blob: Blob, filename: string) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }

  $('saveSvg').addEventListener('click', () => {
    const svg = svgString(256);
    if (svg) download(new Blob([svg], { type: 'image/svg+xml' }), `${fileBase()}.svg`);
  });

  // PNG：SVG を画像として読み込み、指定サイズの canvas に描いてから PNG に変換する
  $('savePng').addEventListener('click', async () => {
    const size = Number($<HTMLSelectElement>('pngSize').value);
    const svg = svgString(size);
    if (!svg) return;
    const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
    const img = new Image();
    img.src = url;
    await img.decode();
    const canvas = document.createElement('canvas');
    canvas.width = size;
    canvas.height = size;
    canvas.getContext('2d')!.drawImage(img, 0, 0, size, size);
    URL.revokeObjectURL(url);
    canvas.toBlob((blob) => blob && download(blob, `${fileBase()}-${size}.png`), 'image/png');
  });

  render();
</script>
