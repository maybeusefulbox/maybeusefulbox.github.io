---
// GlossyBadge の見た目確認用ページ。色・モチーフの組み合わせを一覧で並べる。
import GlossyBadge from '../components/GlossyBadge.astro';

const base = import.meta.env.BASE_URL;

const colors = [
  { name: 'ブルー', hex: '#3a8ee6' },
  { name: 'ピンク', hex: '#f06aa8' },
  { name: 'ミント', hex: '#2fbf9b' },
  { name: 'オレンジ', hex: '#f59a23' },
  { name: 'パープル', hex: '#9b6ae6' },
  { name: 'レッド', hex: '#e64545' },
];
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <title>グロッシーバッジ一覧 | tool_site</title>
    <style>
      body {
        margin: 0;
        padding: 24px 16px;
        font-family: sans-serif;
        background: #f4f6fb;
        color: #222;
      }
      h1 { font-size: 1.4rem; }
      h2 { font-size: 1rem; margin-top: 32px; }
      .grid {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
      }
      figure { margin: 0; text-align: center; }
      figcaption { font-size: 0.8rem; color: #555; }
    </style>
  </head>
  <body>
    <h1>グロッシーバッジ</h1>
    <p><a href={base}>トップへ戻る</a></p>

    <h2>星</h2>
    <div class="grid">
      {colors.map((c) => (
        <figure>
          <GlossyBadge color={c.hex} motif="star" title={`${c.name}の星バッジ`} />
          <figcaption>{c.name}</figcaption>
        </figure>
      ))}
    </div>

    <h2>ハート</h2>
    <div class="grid">
      {colors.map((c) => (
        <figure>
          <GlossyBadge color={c.hex} motif="heart" title={`${c.name}のハートバッジ`} />
          <figcaption>{c.name}</figcaption>
        </figure>
      ))}
    </div>

    <h2>文字</h2>
    <div class="grid">
      <GlossyBadge color="#e64545" text="New" title="Newバッジ" />
      <GlossyBadge color="#3a8ee6" text="完" title="完結バッジ" />
      <GlossyBadge color="#2fbf9b" text="R15" title="R15バッジ" />
      <GlossyBadge color="#f59a23" text="!" title="注意バッジ" />
    </div>

    <h2>サイズ違い</h2>
    <div class="grid" style="align-items: end;">
      <GlossyBadge color="#f06aa8" size={32} />
      <GlossyBadge color="#f06aa8" size={64} />
      <GlossyBadge color="#f06aa8" size={120} />
      <GlossyBadge color="#f06aa8" size={200} />
    </div>
  </body>
</html>
